---
import '../styles/global.css';

const { title } = Astro.props;
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content="Portal de lectura minimalista" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col bg-white text-[#333333] antialiased font-[Inter,sans-serif]">
  <header class="border-b border-[#D9E2EC] bg-white/95 backdrop-blur">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 py-4 md:grid-cols-[1fr_auto_1fr] md:items-center">
        <a href="/" class="text-xl font-semibold tracking-tight text-[#003366] transition-colors hover:text-[#0056B3]">Aletheia</a>

        <nav class="flex items-center justify-start gap-6 text-sm font-medium text-[#003366] md:justify-center">
          <a href="/" class="transition-colors hover:text-[#0056B3]">Inicio</a>
          <a href="/" class="transition-colors hover:text-[#0056B3]">Todos los artículos</a>
        </nav>

        <form action="/" method="GET" class="w-full md:ml-auto md:max-w-[320px]">
        <input 
          type="search" 
          name="q" 
          id="searchInput" 
          placeholder="Buscar artículos..." 
          class="w-full rounded-md border border-[#D9E2EC] bg-white px-4 py-2 text-sm text-[#333333] placeholder-gray-400 focus:border-[#0056B3] focus:outline-none focus:ring-2 focus:ring-[#0056B3]/15" 
        />
        </form>
      </div>
    </div>
  </header>

  <main class="flex-1 bg-[#F8F9FA]">
    <slot />
  </main>

  <footer class="border-t border-[#D9E2EC] bg-white py-6 text-center text-sm text-gray-500">
    <p>© {new Date().getFullYear()} Aletheia. Todos los derechos reservados.</p>
  </footer>

  <slot name="scripts" />
</body>
</html>
