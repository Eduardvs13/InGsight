---
import '../styles/global.css';

const { title, description } = Astro.props;
const metaDesc = description || 'InGsight es la revista académica de ingeniería en español. Artículos de investigación, análisis técnico y divulgación científica para ingenieros y estudiantes.';
const canonicalUrl = Astro.url.href;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={metaDesc} />
  <meta name="author" content="InGsight" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#040d1a" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="InGsight" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={metaDesc} />
  <meta property="og:url"         content={canonicalUrl} />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={metaDesc} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body style="background-color: var(--color-navy-950); color: var(--text-primary); font-family: var(--font-sans); min-height: 100vh; display: flex; flex-direction: column;">

  <!-- ── HEADER ── -->
  <header style="position: sticky; top: 0; z-index: 50; background: var(--surface-header); backdrop-filter: blur(20px) saturate(200%); -webkit-backdrop-filter: blur(20px) saturate(200%); border-bottom: 1px solid var(--surface-border);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 68px;">

        <!-- Logotype -->
        <a href="/" aria-label="InGsight — Inicio" style="display: flex; flex-direction: column; text-decoration: none; flex-shrink: 0;">
          <span style="font-family: var(--font-sans); font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; color: var(--color-white); line-height: 1;">
            In<span style="background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">G</span>sight
          </span>
          <span style="font-size: 0.6rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); line-height: 1; margin-top: 2px;">
            Donde la ingeniería cobra sentido
          </span>
        </a>

        <!-- Nav -->
        <nav aria-label="Navegación principal" style="display: flex; align-items: center; gap: 0.25rem;">
          <a href="/" style="padding: 0.4rem 0.85rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; transition: all 200ms; white-space: nowrap;"
            onmouseover="this.style.color='var(--color-white)'; this.style.background='rgba(37,99,235,0.12)';"
            onmouseout="this.style.color='var(--text-secondary)'; this.style.background='transparent';">
            Inicio
          </a>
          <a href="/" style="padding: 0.4rem 0.85rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; transition: all 200ms; white-space: nowrap;"
            onmouseover="this.style.color='var(--color-white)'; this.style.background='rgba(37,99,235,0.12)';"
            onmouseout="this.style.color='var(--text-secondary)'; this.style.background='transparent';">
            Artículos
          </a>
          <a href="/" style="padding: 0.4rem 0.85rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; transition: all 200ms; white-space: nowrap;"
            onmouseover="this.style.color='var(--color-white)'; this.style.background='rgba(37,99,235,0.12)';"
            onmouseout="this.style.color='var(--text-secondary)'; this.style.background='transparent';">
            Sobre InGsight
          </a>
        </nav>

        <!-- Search -->
        <form action="/" method="GET" role="search" style="position: relative; flex: 1; max-width: 280px;">
          <svg style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); width: 15px; height: 15px; color: var(--text-muted); pointer-events: none;" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="searchInput"
            type="search"
            name="q"
            placeholder="Buscar artículos..."
            autocomplete="off"
            class="input-search"
            aria-label="Buscar artículos en InGsight"
          />
        </form>

      </div>
    </div>
  </header>

  <!-- ── MAIN CONTENT ── -->
  <main style="flex: 1;">
    <slot />
  </main>

  <!-- ── FOOTER ── -->
  <footer style="background: var(--color-navy-900); border-top: 1px solid var(--surface-border); padding: 3rem 1.5rem 2rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-bottom: 2.5rem;">

        <!-- Brand column -->
        <div style="max-width: 380px;">
          <div style="font-family: var(--font-sans); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; color: var(--color-white); margin-bottom: 0.5rem;">
            In<span style="background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">G</span>sight
          </div>
          <p style="font-size: 0.8rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1rem;">
            Donde la ingeniería cobra sentido
          </p>
          <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.7; max-width: 340px;">
            Publicación académica digital dedicada a la divulgación de investigación, innovación y análisis técnico en el campo de la ingeniería en español.
          </p>
        </div>

        <!-- Links column -->
        <div>
          <h3 style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-blue-400); margin-bottom: 1rem;">
            Revista
          </h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem;">
            <li><a href="/" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none; transition: color 200ms;" onmouseover="this.style.color='var(--color-white)'" onmouseout="this.style.color='var(--text-muted)'">Todos los artículos</a></li>
            <li><a href="/" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none; transition: color 200ms;" onmouseover="this.style.color='var(--color-white)'" onmouseout="this.style.color='var(--text-muted)'">Áreas temáticas</a></li>
            <li><a href="/" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none; transition: color 200ms;" onmouseover="this.style.color='var(--color-white)'" onmouseout="this.style.color='var(--text-muted)'">Autores</a></li>
            <li><a href="/" style="font-size: 0.875rem; color: var(--text-muted); text-decoration: none; transition: color 200ms;" onmouseover="this.style.color='var(--color-white)'" onmouseout="this.style.color='var(--text-muted)'">Sobre nosotros</a></li>
          </ul>
        </div>

      </div>

      <!-- Bottom bar -->
      <div style="border-top: 1px solid var(--surface-border); padding-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
        <p style="font-size: 0.8rem; color: var(--text-muted);">
          © {new Date().getFullYear()} InGsight. Todos los derechos reservados.
        </p>
        <p style="font-size: 0.75rem; color: var(--color-navy-600); letter-spacing: 0.04em;">
          Impulsado por <span style="color: var(--text-muted);">Sanity CMS</span> · Desplegado en <span style="color: var(--text-muted);">Vercel</span>
        </p>
      </div>
    </div>
  </footer>

  <slot name="scripts" />
</body>
</html>
