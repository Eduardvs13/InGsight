---
import "../../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#040d1a" />
    <meta name="description" content="Lee artículos de ingeniería publicados en InGsight — investigación aplicada, análisis técnico y divulgación científica en español." />
    <title>InGsight — Artículo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body style="background-color: var(--color-navy-950); color: var(--text-primary); font-family: var(--font-sans); min-height: 100vh; display: flex; flex-direction: column;">

    <!-- ── HEADER ── -->
    <header style="position: sticky; top: 0; z-index: 50; background: var(--surface-header); backdrop-filter: blur(20px) saturate(200%); -webkit-backdrop-filter: blur(20px) saturate(200%); border-bottom: 1px solid var(--surface-border);">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 68px;">
          <a href="/" aria-label="InGsight — Inicio" style="display: flex; flex-direction: column; text-decoration: none; flex-shrink: 0;">
            <span style="font-family: var(--font-sans); font-size: 1.375rem; font-weight: 700; letter-spacing: -0.02em; color: var(--color-white); line-height: 1;">
              In<span style="background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">G</span>sight
            </span>
            <span style="font-size: 0.6rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); line-height: 1; margin-top: 2px;">
              Donde la ingeniería cobra sentido
            </span>
          </a>
          <nav aria-label="Navegación principal" style="display: flex; align-items: center; gap: 0.25rem;">
            <a href="/" style="padding: 0.4rem 0.85rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; transition: all 200ms;"
              onmouseover="this.style.color='var(--color-white)'; this.style.background='rgba(37,99,235,0.12)';"
              onmouseout="this.style.color='var(--text-secondary)'; this.style.background='transparent';">
              Inicio
            </a>
            <a href="/" style="padding: 0.4rem 0.85rem; border-radius: 8px; font-size: 0.875rem; font-weight: 500; color: var(--text-secondary); text-decoration: none; transition: all 200ms;"
              onmouseover="this.style.color='var(--color-white)'; this.style.background='rgba(37,99,235,0.12)';"
              onmouseout="this.style.color='var(--text-secondary)'; this.style.background='transparent';">
              Artículos
            </a>
          </nav>
        </div>
      </div>
    </header>

    <!-- ── MAIN CONTENT ── -->
    <main style="flex: 1; max-width: 900px; margin: 0 auto; width: 100%; padding: 2.5rem 1.5rem 5rem;">

      <!-- Back link -->
      <a href="/"
        style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 500; color: var(--text-muted); text-decoration: none; margin-bottom: 2rem; padding: 0.4rem 0.85rem; border: 1px solid var(--surface-border); border-radius: 8px; transition: all 200ms; background: rgba(15,32,64,0.4);"
        onmouseover="this.style.color='var(--color-white)'; this.style.borderColor='var(--color-blue-400)'; this.style.background='rgba(37,99,235,0.1)';"
        onmouseout="this.style.color='var(--text-muted)'; this.style.borderColor='var(--surface-border)'; this.style.background='rgba(15,32,64,0.4)';">
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Volver a InGsight
      </a>

      <!-- Article root -->
      <div id="article-root">
        <!-- Skeleton loader -->
        <div id="article-skeleton">
          <div style="text-align: center; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--surface-border);">
            <div class="skeleton" style="width: 120px; height: 18px; margin: 0 auto 1.25rem;"></div>
            <div class="skeleton" style="width: 80%; height: 44px; margin: 0 auto 0.75rem;"></div>
            <div class="skeleton" style="width: 55%; height: 44px; margin: 0 auto 1.25rem;"></div>
            <div class="skeleton" style="width: 160px; height: 18px; margin: 0 auto;"></div>
          </div>
          <div class="skeleton" style="width: 100%; height: 360px; margin-bottom: 2.5rem; border-radius: var(--radius-lg);"></div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div class="skeleton" style="width: 100%; height: 16px;"></div>
            <div class="skeleton" style="width: 95%; height: 16px;"></div>
            <div class="skeleton" style="width: 88%; height: 16px;"></div>
            <div class="skeleton" style="width: 92%; height: 16px;"></div>
          </div>
        </div>
      </div>

      <script type="module">
        const PROJECT_ID = "8knpnv8f";
        const DATASET    = "production";

        function escapeHtml(s = "") {
          return String(s).replace(/[&<>"']/g, c =>
            ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])
          );
        }

        function imageUrlFromRef(ref) {
          if (!ref) return "";
          const m = ref.match(/^image-(.+)-([0-9]+x[0-9]+)-([a-z0-9]+)$/i);
          if (!m) return "";
          const [, id, dim, fmt] = m;
          return `https://cdn.sanity.io/images/${PROJECT_ID}/${DATASET}/${id}-${dim}.${fmt === "jpeg" ? "jpg" : fmt}`;
        }

        function portableTextToHtml(blocks = []) {
          if (!Array.isArray(blocks)) return "";
          return blocks.map(block => {
            if (!block) return "";
            if (block._type === "block") {
              const inline = (block.children || []).map(c => {
                let t = escapeHtml(c.text || "");
                if (c.marks?.includes("strong")) t = `<strong>${t}</strong>`;
                if (c.marks?.includes("em"))     t = `<em>${t}</em>`;
                if (c.marks?.includes("code"))   t = `<code>${t}</code>`;
                // Handle link marks
                const linkMark = (c.marks || []).find(mk => typeof mk === "string" && mk.startsWith("link"));
                if (linkMark) {
                  const def = (block.markDefs || []).find(d => d._key === linkMark);
                  if (def?.href) t = `<a href="${escapeHtml(def.href)}" target="_blank" rel="noopener noreferrer">${t}</a>`;
                }
                return t;
              }).join("");

              const style = block.style || "normal";
              if (style === "h1") return `<h1>${inline}</h1>`;
              if (style === "h2") return `<h2>${inline}</h2>`;
              if (style === "h3") return `<h3>${inline}</h3>`;
              if (style === "h4") return `<h4>${inline}</h4>`;
              if (style === "blockquote") return `<blockquote>${inline}</blockquote>`;
              if (style === "normal" && !inline.trim()) return "";
              return `<p>${inline}</p>`;
            }
            if (block._type === "image" && block.asset?._ref) {
              const src = imageUrlFromRef(block.asset._ref);
              const alt = escapeHtml(block.alt || "Imagen del artículo");
              return `<figure>
                <img src="${src}" alt="${alt}" loading="lazy" style="width:100%; border-radius:var(--radius-lg); border:1px solid var(--surface-border);"/>
                ${block.alt ? `<figcaption>${alt}</figcaption>` : ""}
              </figure>`;
            }
            return "";
          }).join("\n");
        }

        function readingTime(blocks = []) {
          const text = (blocks || []).flatMap(b => (b?.children || []).map(c => c?.text || "")).join(" ");
          return Math.max(1, Math.round(text.split(/\s+/).length / 200));
        }

        async function loadArticle() {
          const root    = document.getElementById("article-root");
          const params  = new URLSearchParams(location.search);
          const slugQ   = params.get("slug");
          const parts   = location.pathname.split("/").filter(Boolean);
          const slugP   = parts[parts.length - 1];
          const slug    = slugQ || slugP;

          if (!slug || slug === "articles") {
            root.innerHTML = `
              <div style="text-align:center; padding: 5rem 2rem;">
                <p style="font-size:1rem; color:var(--text-muted);">No se especificó un artículo.</p>
                <a href="/" class="btn-primary" style="margin-top:1.5rem; display:inline-flex;">← Volver al inicio</a>
              </div>`;
            return;
          }

          const groq = `*[_type=="article" && slug.current=="${slug}"][0]{titulo, fechaPublicacion, palabrasClave, autores[]{nombre,apellido}, portada, contenido}`;
          const url  = `https://${PROJECT_ID}.api.sanity.io/v1/data/query/${DATASET}?query=${encodeURIComponent(groq)}`;

          try {
            const res  = await fetch(url);
            const json = await res.json();
            const doc  = json.result;

            if (!doc) {
              root.innerHTML = `
                <div style="text-align:center; padding: 5rem 2rem; border: 1px dashed var(--surface-border); border-radius:var(--radius-xl);">
                  <p style="font-size:1.1rem; font-weight:600; color:var(--text-primary); margin-bottom:0.5rem;">Artículo no encontrado</p>
                  <p style="font-size:0.875rem; color:var(--text-muted); margin-bottom:1.5rem;">El artículo que buscas no existe o ha sido eliminado.</p>
                  <a href="/" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;font-weight:600;color:var(--color-blue-400);text-decoration:none;">← Volver a InGsight</a>
                </div>`;
              return;
            }

            const dateStr  = doc.fechaPublicacion
              ? new Date(doc.fechaPublicacion).toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
              : "";
            const authors  = (doc.autores || []).map(a => [a.nombre, a.apellido].filter(Boolean).join(" ")).join(", ") || "InGsight";
            const authorI  = doc.autores?.length ? `${(doc.autores[0].nombre||"?")[0]}${(doc.autores[0].apellido||"?")[0]}`.toUpperCase() : "IG";
            const cover    = doc.portada?.asset?._ref ? imageUrlFromRef(doc.portada.asset._ref) : null;
            const rt       = readingTime(doc.contenido);
            const keywords = Array.isArray(doc.palabrasClave) ? doc.palabrasClave : [];
            const bodyHtml = portableTextToHtml(doc.contenido);

            document.title = `${escapeHtml(doc.titulo)} — InGsight`;

            root.innerHTML = `
              <article itemscope itemtype="https://schema.org/ScholarlyArticle">

                <!-- Article header -->
                <header style="text-align:center; margin-bottom:2.5rem; padding-bottom:2.5rem; border-bottom:1px solid var(--surface-border);">
                  <div style="display:flex; align-items:center; justify-content:center; gap:0.75rem; margin-bottom:1.25rem; flex-wrap:wrap;">
                    ${dateStr ? `<span class="badge badge-accent" itemprop="datePublished" content="${escapeHtml(doc.fechaPublicacion || '')}">${escapeHtml(dateStr)}</span>` : ""}
                    <span class="badge badge-teal">
                      <svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                      ${rt} min de lectura
                    </span>
                    <span class="badge badge-accent">Artículo de ingeniería</span>
                  </div>

                  <h1 style="font-family:var(--font-display); font-size:clamp(2rem,4vw,3.25rem); font-weight:800; line-height:1.15; color:var(--color-white); letter-spacing:-0.02em; margin-bottom:1.5rem; word-break:break-word;" itemprop="headline">
                    ${escapeHtml(doc.titulo)}
                  </h1>

                  <!-- Author -->
                  <div style="display:inline-flex; align-items:center; gap:0.75rem; padding:0.65rem 1.25rem; border-radius:999px; background:rgba(15,32,64,0.6); border:1px solid var(--surface-border);" itemprop="author" itemscope itemtype="https://schema.org/Person">
                    <div style="width:36px; height:36px; border-radius:50%; background:var(--gradient-brand); display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:700; color:white; flex-shrink:0;" aria-hidden="true">
                      ${escapeHtml(authorI)}
                    </div>
                    <div style="text-align:left;">
                      <p style="font-size:0.8rem; color:var(--text-muted); margin:0; line-height:1.2;">Autor${(doc.autores||[]).length > 1 ? "es" : ""}</p>
                      <p style="font-size:0.9rem; color:var(--text-secondary); font-weight:600; margin:0;" itemprop="name">${escapeHtml(authors)}</p>
                    </div>
                  </div>
                </header>

                <!-- Cover image -->
                ${cover ? `
                  <div style="margin-bottom:2.5rem; border-radius:var(--radius-xl); overflow:hidden; border:1px solid var(--surface-border);">
                    <img
                      src="${cover}"
                      alt="${escapeHtml(doc.titulo)}"
                      loading="eager"
                      style="width:100%; aspect-ratio:16/9; object-fit:cover; display:block;"
                      itemprop="image"
                    />
                  </div>
                ` : ""}

                <!-- Article body -->
                <div
                  class="prose prose-lg prose-invert prose-ingsight max-w-none"
                  style="color:var(--text-secondary); font-size:1.0625rem; line-height:1.85;"
                  itemprop="articleBody"
                >
                  ${bodyHtml}
                </div>

                <!-- Keywords -->
                ${keywords.length ? `
                  <footer style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--surface-border);">
                    <p style="font-size:0.7rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.75rem;">Palabras clave</p>
                    <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                      ${keywords.map(k => `
                        <span style="font-size:0.75rem; padding:4px 12px; border-radius:999px; background:rgba(37,99,235,0.1); border:1px solid rgba(37,99,235,0.2); color:var(--color-blue-300); font-weight:500;">
                          ${escapeHtml(k)}
                        </span>
                      `).join("")}
                    </div>
                  </footer>
                ` : ""}

                <!-- Back link bottom -->
                <div style="margin-top:3rem; text-align:center;">
                  <a href="/"
                    style="display:inline-flex; align-items:center; gap:6px; font-size:0.875rem; font-weight:600; color:var(--color-blue-400); text-decoration:none; padding:0.65rem 1.4rem; border:1px solid rgba(59,130,246,0.25); border-radius:var(--radius-md); transition:all 200ms;"
                    onmouseover="this.style.background='rgba(37,99,235,0.15)'; this.style.color='var(--color-blue-300)'"
                    onmouseout="this.style.background='transparent'; this.style.color='var(--color-blue-400)'">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Explorar más artículos
                  </a>
                </div>

              </article>
            `;
          } catch (err) {
            root.innerHTML = `
              <div style="text-align:center; padding: 5rem 2rem; border:1px solid rgba(239,68,68,0.2); border-radius:var(--radius-xl); background:rgba(239,68,68,0.05);">
                <p style="font-size:1rem; font-weight:600; color:#fca5a5; margin-bottom:0.5rem;">Error al cargar el artículo</p>
                <p style="font-size:0.875rem; color:var(--text-muted); margin-bottom:1.5rem;">No se pudo conectar con el servidor de contenido. Intenta de nuevo.</p>
                <button onclick="loadArticle()" class="btn-ghost">Reintentar</button>
              </div>`;
            console.error("[InGsight] Error fetching article:", err);
          }
        }

        window.loadArticle = loadArticle;
        loadArticle();
        window.addEventListener("popstate", loadArticle);
      </script>
    </main>

    <!-- ── FOOTER ── -->
    <footer style="background: var(--color-navy-900); border-top: 1px solid var(--surface-border); padding: 1.75rem 1.5rem; text-align: center;">
      <p style="font-size: 0.8rem; color: var(--text-muted);">
        © {new Date().getFullYear()} InGsight — Donde la ingeniería cobra sentido
      </p>
    </footer>

  </body>
</html>
