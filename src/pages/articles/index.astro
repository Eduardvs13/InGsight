---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="InGsight — Artículo">
  <main style="flex: 1; max-width: 1000px; margin: 0 auto; width: 100%; padding: 1.5rem 1.5rem 3rem;">
    <!-- Article root -->
    <div id="article-root">
      <!-- Skeleton loader -->
      <div id="article-skeleton">
        <div style="text-align: center; margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--surface-border);">
          <div class="skeleton" style="width: 120px; height: 18px; margin: 0 auto 1.25rem;"></div>
          <div class="skeleton" style="width: 80%; height: 44px; margin: 0 auto 0.75rem;"></div>
          <div class="skeleton" style="width: 55%; height: 44px; margin: 0 auto 1.25rem;"></div>
          <div class="skeleton" style="width: 160px; height: 18px; margin: 0 auto;"></div>
        </div>
        <div class="skeleton" style="width: 100%; height: 360px; margin-bottom: 2.5rem; border-radius: var(--radius-lg);"></div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <div class="skeleton" style="width: 100%; height: 16px;"></div>
          <div class="skeleton" style="width: 95%; height: 16px;"></div>
          <div class="skeleton" style="width: 88%; height: 16px;"></div>
          <div class="skeleton" style="width: 92%; height: 16px;"></div>
        </div>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script type="module">
      const PROJECT_ID = "8knpnv8f";
      const DATASET    = "production";

      function escapeHtml(s = "") {
        return String(s).replace(/[&<>"']/g, c =>
          ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])
        );
      }

      function imageUrlFromRef(ref) {
        if (!ref) return "";
        const m = ref.match(/^image-(.+)-([0-9]+x[0-9]+)-([a-z0-9]+)$/i);
        if (!m) return "";
        const [, id, dim, fmt] = m;
        return `https://cdn.sanity.io/images/${PROJECT_ID}/${DATASET}/${id}-${dim}.${fmt === "jpeg" ? "jpg" : fmt}`;
      }

      function portableTextToHtml(blocks = []) {
        if (!Array.isArray(blocks)) return "";
        return blocks.map(block => {
          if (!block) return "";
          if (block._type === "block") {
            const inline = (block.children || []).map(c => {
              let t = escapeHtml(c.text || "");
              if (c.marks?.includes("strong")) t = `<strong>${t}</strong>`;
              if (c.marks?.includes("em"))     t = `<em>${t}</em>`;
              if (c.marks?.includes("code"))   t = `<code>${t}</code>`;
              const linkMark = (c.marks || []).find(mk => typeof mk === "string" && mk.startsWith("link"));
              if (linkMark) {
                const def = (block.markDefs || []).find(d => d._key === linkMark);
                if (def?.href) t = `<a href="${escapeHtml(def.href)}" target="_blank" rel="noopener noreferrer">${t}</a>`;
              }
              return t;
            }).join("");

            const style = block.style || "normal";
            if (style === "h1") return `<h1>${inline}</h1>`;
            if (style === "h2") return `<h2>${inline}</h2>`;
            if (style === "h3") return `<h3>${inline}</h3>`;
            if (style === "h4") return `<h4>${inline}</h4>`;
            if (style === "blockquote") return `<blockquote>${inline}</blockquote>`;
            if (style === "normal" && !inline.trim()) return "";
            return `<p>${inline}</p>`;
          }
          if (block._type === "image" && block.asset?._ref) {
            const src = imageUrlFromRef(block.asset._ref);
            const alt = escapeHtml(block.alt || "Imagen del artículo");
            return `<figure>
              <img src="${src}" alt="${alt}" loading="lazy" style="width:100%; border-radius:var(--radius-lg); border:1px solid var(--surface-border);"/>
              ${block.alt ? `<figcaption>${alt}</figcaption>` : ""}
            </figure>`;
          }
          return "";
        }).join("\n");
      }

      function readingTime(blocks = []) {
        const text = (blocks || []).flatMap(b => (b?.children || []).map(c => c?.text || "")).join(" ");
        return Math.max(1, Math.round(text.split(/\s+/).length / 200));
      }

      async function loadArticle() {
        const root    = document.getElementById("article-root");
        const params  = new URLSearchParams(location.search);
        const slugQ   = params.get("slug");
        const parts   = location.pathname.split("/").filter(Boolean);
        const slugP   = parts[parts.length - 1];
        const slug    = slugQ || slugP;

        if (!slug || slug === "articles") {
          root.innerHTML = `
            <div style="text-align:center; padding: 5rem 2rem;">
              <p style="font-size:1rem; color:var(--text-muted);">No se especificó un artículo.</p>
              <a href="/" class="btn-primary" style="margin-top:1.5rem; display:inline-flex;">← Volver al inicio</a>
            </div>`;
          return;
        }

        const groq = `*[_type=="article" && slug.current=="${slug}"][0]{titulo, fechaPublicacion, palabrasClave, autores[]->{nombre,apellido}, portada, contenido, bibliografia}`;
        const url  = `https://${PROJECT_ID}.api.sanity.io/v1/data/query/${DATASET}?query=${encodeURIComponent(groq)}`;

        try {
          const res  = await fetch(url);
          const json = await res.json();
          const doc  = json.result;

          if (!doc) {
            root.innerHTML = `
              <div style="text-align:center; padding: 5rem 2rem; border: 1px dashed var(--surface-border); border-radius:var(--radius-xl);">
                <p style="font-size:1.1rem; font-weight:600; color:var(--text-primary); margin-bottom:0.5rem;">Artículo no encontrado</p>
                <p style="font-size:0.875rem; color:var(--text-muted); margin-bottom:1.5rem;">El artículo que buscas no existe o ha sido eliminado.</p>
                <a href="/" style="display:inline-flex;align-items:center;gap:6px;font-size:0.85rem;font-weight:600;color:var(--color-blue-400);text-decoration:none;">← Volver a InGsight</a>
              </div>`;
            return;
          }

          const dateStr  = doc.fechaPublicacion
            ? new Date(doc.fechaPublicacion).toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })
            : "";
          const authors  = (doc.autores || []).map(a => [a.nombre, a.apellido].filter(Boolean).join(" ")).join(", ") || "InGsight";
          const authorI  = doc.autores?.length ? `${(doc.autores[0].nombre||"?")[0]}${(doc.autores[0].apellido||"?")[0]}`.toUpperCase() : "IG";
          const cover    = doc.portada?.asset?._ref ? imageUrlFromRef(doc.portada.asset._ref) : null;
          const rt       = readingTime(doc.contenido);
          const keywords = Array.isArray(doc.palabrasClave) ? doc.palabrasClave : [];
          const bodyHtml = portableTextToHtml(doc.contenido);
          const bibHtml  = doc.bibliografia ? portableTextToHtml(doc.bibliografia) : null;

          document.title = `${escapeHtml(doc.titulo)} — InGsight`;

          root.innerHTML = `
            <article itemscope itemtype="https://schema.org/ScholarlyArticle">

              <!-- Back link top -->
              <div style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                <a href="/" style="display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.875rem; font-weight: 500; text-decoration: none; padding: 0.5rem 1rem; background: var(--pill-bg); border: 1px solid var(--surface-border); border-radius: 999px; transition: all 200ms;"
                  onmouseover="this.style.color='var(--text-primary)'; this.style.background='var(--surface-border)';"
                  onmouseout="this.style.color='var(--text-muted)'; this.style.background='var(--pill-bg)';">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Volver a InGsight
                </a>
              </div>

              <!-- Meta row -->
              <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
                <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--pill-accent-text); padding: 0.35rem 0.85rem; background: var(--pill-accent-bg); border-radius: 999px;">
                  ${dateStr}
                </span>
                <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--pill-accent-text); padding: 0.35rem 0.85rem; background: var(--pill-accent-bg); border-radius: 999px;">
                  <span style="display: inline-block; vertical-align: middle; margin-right: 4px;">
                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  </span>
                  ${rt} min de lectura
                </span>
                <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--pill-accent-text); padding: 0.35rem 0.85rem; background: var(--pill-accent-bg); border-radius: 999px;">
                  Artículo de Ingeniería
                </span>
              </div>

              <!-- Title -->
              <h1 style="font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: var(--text-title); margin-bottom: 1.5rem; text-wrap: balance;" itemprop="headline">
                ${escapeHtml(doc.titulo)}
              </h1>

              <!-- Author -->
              <div style="display:inline-flex; align-items:center; gap:0.75rem; padding:0.65rem 1.25rem; border-radius:999px; background:var(--pill-bg); border:1px solid var(--surface-border);" itemprop="author" itemscope itemtype="https://schema.org/Person">
                  <div style="width:36px; height:36px; border-radius:50%; background:var(--gradient-brand); display:flex; align-items:center; justify-content:center; font-size:0.7rem; font-weight:700; color:white; flex-shrink:0;" aria-hidden="true">
                    ${escapeHtml(authorI)}
                  </div>
                  <div style="text-align:left;">
                    <p style="font-size:0.8rem; color:var(--text-muted); margin:0; line-height:1.2;">Autor${(doc.autores||[]).length > 1 ? "es" : ""}</p>
                    <p style="font-size:0.9rem; color:var(--text-secondary); font-weight:600; margin:0;" itemprop="name">${escapeHtml(authors)}</p>
                  </div>
              </div>

              <!-- Cover image -->
              ${cover ? `
                <div style="margin-top: 3rem; margin-bottom:2.5rem; border-radius:var(--radius-xl); overflow:hidden; border:1px solid var(--surface-border);">
                  <img
                    src="${cover}"
                    alt="${escapeHtml(doc.titulo)}"
                    loading="eager"
                    style="width:100%; aspect-ratio:16/9; object-fit:cover; display:block;"
                    itemprop="image"
                  />
                </div>
              ` : ""}

              <!-- Article body -->
              <div
                class="prose prose-lg prose-invert prose-ingsight max-w-none"
                style="color:var(--text-secondary); font-size:1.0625rem; line-height:1.85;"
                itemprop="articleBody"
              >
                ${bodyHtml}
              </div>

              <!-- Keywords -->
              ${keywords.length ? `
                <footer style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--surface-border);">
                  <p style="font-size:0.7rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.75rem;">Palabras clave</p>
                  <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                    ${keywords.map(k => `
                      <span style="font-size:0.75rem; padding:4px 12px; border-radius:999px; background:var(--pill-accent-bg); border:1px solid var(--surface-border); color:var(--pill-accent-text); font-weight:500;">
                        ${escapeHtml(k)}
                      </span>
                    `).join("")}
                  </div>
                </footer>
              ` : ""}

              <!-- Bibliografía -->
              ${bibHtml ? `
                <section style="margin-top:3rem; padding:2rem 2.5rem; border-radius:var(--radius-lg); background:var(--surface-card); border:1px solid var(--surface-border);">
                  <h2 style="font-family:var(--font-display); font-size:1.5rem; font-weight:700; color:var(--text-primary); margin-bottom:1.5rem; border-bottom:1px solid var(--surface-border); padding-bottom:0.75rem;">Bibliografía</h2>
                  <div class="prose prose-sm prose-invert prose-ingsight max-w-none" style="font-size:0.9rem; line-height:1.7;">
                    ${bibHtml}
                  </div>
                </section>
              ` : ""}

              <!-- Back link bottom -->
              <div style="margin-top:3rem; text-align:center;">
                <a href="/"
                   style="display:inline-flex; align-items:center; gap:0.5rem; color:var(--text-accent); font-size:0.875rem; font-weight:600; text-decoration:none; padding:0.6rem 1.5rem; border-radius:999px; background:var(--pill-bg); border:1px solid var(--surface-border); transition:all 200ms;"
                   onmouseover="this.style.background='var(--surface-border)';"
                   onmouseout="this.style.background='var(--pill-bg)';">
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                  Explorar más artículos
                </a>
              </div>

            </article>
          `;
        } catch (err) {
          root.innerHTML = `
            <div style="text-align:center; padding: 5rem 2rem; border:1px solid rgba(239,68,68,0.2); border-radius:var(--radius-xl); background:rgba(239,68,68,0.05);">
              <p style="font-size:1rem; font-weight:600; color:#fca5a5; margin-bottom:0.5rem;">Error al cargar el artículo</p>
              <p style="font-size:0.875rem; color:var(--text-muted); margin-bottom:1.5rem;">No se pudo conectar con el servidor de contenido. Intenta de nuevo.</p>
              <button onclick="loadArticle()" class="btn-ghost">Reintentar</button>
            </div>`;
          console.error("[InGsight] Error fetching article:", err);
        }
      }

      window.loadArticle = loadArticle;
      loadArticle();
      window.addEventListener("popstate", loadArticle);
    </script>
  </Fragment>
</MainLayout>
