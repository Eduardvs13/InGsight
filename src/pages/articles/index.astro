---
---

<main class="max-w-3xl mx-auto px-4 py-12">
  <a href="/" class="text-sm text-indigo-600 hover:underline">← Volver</a>
  <div id="article-root" class="mt-6">Cargando artículo...</div>

  <script type="module">
    const projectId = '8knpnv8f';
    const dataset = 'production';

    function escapeHtml(s = '') { return String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

    function portableTextToSimpleHtml(blocks = []) {
      if (!Array.isArray(blocks)) return '';
      return blocks.map(block => {
        if (block._type === 'block') {
          const text = (block.children || []).map(c => c.text).join('');
          if (block.style === 'h1') return `<h1>${escapeHtml(text)}</h1>`;
          if (block.style === 'h2') return `<h2>${escapeHtml(text)}</h2>`;
          return `<p>${escapeHtml(text)}</p>`;
        }
        if (block._type === 'image' && block.asset && block.asset._ref) {
          const ref = block.asset._ref;
          const src = `https://cdn.sanity.io/images/${projectId}/${dataset}/${ref.replace(/^image-/, '').replace(/-png$|-jpg$|-jpeg$|-webp$|-.+$/,'')}.jpg`;
          return `<img src="${src}" alt="${escapeHtml(block.alt || '')}" />`;
        }
        return '';
      }).join('\n');
    }

    async function fetchArticleForPath(pathname) {
      const parts = pathname.split('/').filter(Boolean);
      const slug = parts[parts.length - 1];
      const groq = `*[_type=="article" && slug.current=="${slug}"][0]{titulo, fechaPublicacion, autores[]{nombre,apellido}, portada, contenido}`;
      const url = `https://${projectId}.api.sanity.io/v1/data/query/${dataset}?query=${encodeURIComponent(groq)}`;
      const root = document.getElementById('article-root');
      try {
        const res = await fetch(url);
        const json = await res.json();
        const doc = json.result;
        if (!doc) { root.innerHTML = '<p>Artículo no encontrado</p>'; return; }

        const autores = (doc.autores||[]).map(a => [a.nombre,a.apellido].filter(Boolean).join(' ')).join(', ');
        const cover = doc.portada && doc.portada.asset && doc.portada.asset._ref ? `https://cdn.sanity.io/images/${projectId}/${dataset}/${doc.portada.asset._ref.replace(/^image-/, '').replace(/-jpg$|-png$|-jpeg$|-.+$/,'')}.jpg` : null;

        root.innerHTML = `
          <article class="bg-white rounded-2xl p-8 shadow-sm">
            <header class="mb-6">
              <h1 class="text-3xl font-extrabold leading-tight">${escapeHtml(doc.titulo)}</h1>
              <p class="text-sm text-gray-500 mt-2">${doc.fechaPublicacion ? new Date(doc.fechaPublicacion).toLocaleDateString('es-ES',{year:'numeric',month:'long',day:'numeric'}) : ''} — ${escapeHtml(autores)}</p>
            </header>
            ${cover ? `<img src="${cover}" alt="${escapeHtml(doc.titulo)}" class="w-full rounded-lg mb-6 object-cover"/>` : ''}
            <div class="prose max-w-none">${portableTextToSimpleHtml(doc.contenido)}</div>
          </article>
        `;
      } catch (err) {
        root.innerHTML = '<p>Error cargando artículo</p>';
        console.error(err);
      }
    }

    // Render for current path
    fetchArticleForPath(location.pathname);

    // Handle history navigation within the same page (optional)
    window.addEventListener('popstate', () => fetchArticleForPath(location.pathname));
  </script>
</main>
