---
import MainLayout from "../../layouts/MainLayout.astro";
import portableTextToHtml from "../../sanity/portableTextToHtml";
import client, { urlFor } from "../../sanity/sanityClient";
import { getAllArticleSlugs, getArticleBySlug } from "../../sanity/queries";

export async function getStaticPaths() {
  try {
    const slugs = await client.fetch(getAllArticleSlugs);
    return (slugs ?? [])
      .filter((slug) => typeof slug === "string" && slug.length > 0)
      .map((slug) => ({ params: { slug } }));
  } catch (error) {
    console.error("Failed to fetch article slugs:", error);
    return [];
  }
}

const { slug } = Astro.params;
const article = slug ? await client.fetch(getArticleBySlug, { slug }) : null;

const dateStr = article?.fechaPublicacion
  ? new Date(article.fechaPublicacion).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const autoresStr = (article?.autores ?? [])
  .map((a) => [a?.nombre, a?.apellido].filter(Boolean).join(" "))
  .filter(Boolean)
  .join(", ");

const htmlContent = article?.contenido
  ? portableTextToHtml(article.contenido)
  : "<p>No hay contenido disponible.</p>";
---

<MainLayout title={`${article?.titulo ?? "Artículo"} | Aletheia`}>
  {
    article ? (
      <article class="mx-auto max-w-[800px] px-4 py-10 sm:px-6 lg:px-0">
        <header class="border-b border-[#D9E2EC] pb-8 text-center">
          <div class="text-sm font-semibold uppercase tracking-[0.2em] text-[#0056B3]">{dateStr}</div>
          <h1 class="mt-4 text-3xl font-semibold leading-tight text-[#003366] sm:text-5xl">{article.titulo}</h1>
          <div class="mt-5 text-base text-gray-500 sm:text-lg">Por <span class="font-medium text-gray-800">{autoresStr}</span></div>
        </header>

        {
          article.portada && (
            <figure class="mt-8 mb-10 overflow-hidden rounded-2xl border border-[#E5EAF0] bg-white shadow-sm">
              <img
                src={urlFor(article.portada).width(1200).height(675).url()}
                alt={`Portada de ${article.titulo}`}
                class="h-auto w-full object-cover"
              />
            </figure>
          )
        }

        <div class="prose prose-lg max-w-none text-[#333333] leading-8 prose-headings:text-[#003366] prose-a:text-[#0056B3] prose-a:no-underline hover:prose-a:underline prose-p:mb-6 break-words overflow-x-hidden">
          <Fragment set:html={htmlContent} />
        </div>

        <footer class="mt-16 border-t border-[#D9E2EC] pt-8 text-center">
          <a href="/" class="inline-block rounded-md bg-[#0056B3] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#003366]">
            Volver a todos los artículos
          </a>
        </footer>
      </article>
    ) : (
      <article class="mx-auto max-w-[800px] px-4 py-10 text-center sm:px-6 lg:px-0">
        <h1 class="text-2xl font-semibold text-[#003366]">Artículo no encontrado</h1>
        <p class="mt-4 text-gray-600">El artículo solicitado no existe o fue removido.</p>
        <a href="/" class="mt-8 inline-block rounded-md bg-[#0056B3] px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-[#003366]">
          Volver al inicio
        </a>
      </article>
    )
  }
</MainLayout>