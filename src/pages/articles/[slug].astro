---
import MainLayout from "../../layouts/MainLayout.astro";
import portableTextToHtml from "../../sanity/portableTextToHtml";
import client, { urlFor } from "../../sanity/sanityClient";
import { getAllArticleSlugs, getArticleBySlug } from "../../sanity/queries";

export async function getStaticPaths() {
  try {
    const slugs = await client.fetch(getAllArticleSlugs);
    return (slugs ?? [])
      .filter((slug) => typeof slug === "string" && slug.length > 0)
      .map((slug) => ({ params: { slug } }));
  } catch (error) {
    console.error("Failed to fetch article slugs:", error);
    return [];
  }
}

const { slug } = Astro.params;
const article = slug ? await client.fetch(getArticleBySlug, { slug }) : null;

const dateStr = article?.fechaPublicacion
  ? new Date(article.fechaPublicacion).toLocaleDateString("es-ES", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const autoresStr = (article?.autores ?? [])
  .map((a) => [a?.nombre, a?.apellido].filter(Boolean).join(" "))
  .filter(Boolean)
  .join(", ");

const htmlContent = article?.contenido
  ? portableTextToHtml(article.contenido)
  : "<p>No hay contenido disponible.</p>";
---

<MainLayout title={`${article?.titulo ?? "Artículo"} | Aletheia`}>
  {
    article ? (
      <article class="max-w-[800px] mx-auto bg-white p-8 md:p-12 shadow-sm rounded-lg border border-gray-100">
        <header class="mb-10 text-center border-b border-gray-200 pb-8">
          <div class="text-[#0056B3] font-medium mb-3 uppercase tracking-wider text-sm">{dateStr}</div>
          <h1 class="text-3xl md:text-5xl font-bold text-[#003366] leading-tight mb-6">{article.titulo}</h1>
          <div class="text-lg text-gray-500">Por <span class="font-semibold text-gray-800">{autoresStr}</span></div>
        </header>

        {
          article.portada && (
            <figure class="mb-10">
              <img
                src={urlFor(article.portada).width(1200).height(675).url()}
                alt={`Portada de ${article.titulo}`}
                class="w-full rounded-lg shadow-sm"
              />
            </figure>
          )
        }

        <div class="prose prose-lg max-w-none text-[#333333] leading-relaxed prose-headings:text-[#003366] prose-a:text-[#0056B3] prose-a:no-underline hover:prose-a:underline prose-p:mb-6 break-words overflow-x-hidden">
          <Fragment set:html={htmlContent} />
        </div>

        <footer class="mt-16 pt-8 border-t border-gray-200 text-center">
          <a href="/" class="inline-block px-8 py-3 bg-[#0056B3] text-white font-medium rounded hover:bg-[#003366] transition-colors shadow-sm">
            ← Volver a todos los artículos
          </a>
        </footer>
      </article>
    ) : (
      <article class="max-w-[800px] mx-auto bg-white p-8 md:p-12 shadow-sm rounded-lg border border-gray-100 text-center">
        <h1 class="text-2xl font-bold text-[#003366]">Artículo no encontrado</h1>
        <p class="mt-4 text-gray-600">El artículo solicitado no existe o fue removido.</p>
        <a href="/" class="inline-block mt-8 px-6 py-2 bg-[#0056B3] text-white font-medium rounded hover:bg-[#003366] transition-colors">
          Volver al inicio
        </a>
      </article>
    )
  }
</MainLayout>