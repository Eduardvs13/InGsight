---
import MainLayout from "../layouts/MainLayout.astro";
import client from "../sanity/sanityClient";
import { getAllArticles } from "../sanity/queries";
import { urlFor } from "../sanity/sanityClient";

const articles = await client.fetch(getAllArticles);

function plainTextFromPortableText(blocks = []) {
  if (!Array.isArray(blocks)) return "";

  return blocks
    .map((block) => (block?.children || []).map((child) => child?.text || "").join(" "))
    .join(" ")
    .replace(/\s+/g, " ")
    .trim();
}

function excerptFromPortableText(blocks = []) {
  const text = plainTextFromPortableText(blocks);
  if (!text) return "Lectura académica disponible en el archivo de la revista.";

  const excerpt = text.slice(0, 180).trim();
  return excerpt.length < text.length ? `${excerpt}...` : excerpt;
}
---

<MainLayout title="Aletheia - Revista Academica">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-[#0056B3]">Revista académica</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[#003366] sm:text-5xl">Lectura simple, fondo blanco, acento azul.</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[#333333] sm:text-lg">
        Un archivo editorial limpio para leer artículos científicos con prioridad absoluta en claridad, navegación y tipografía.
      </p>
    </div>

    <div class="mt-10 border-b border-[#D9E2EC] pb-3 text-sm text-gray-500">
      {articles.length} artículos disponibles
    </div>

    <div class="mt-8 space-y-6" id="article-list">
      {articles.map((article) => {
        const cover = article.portada ? urlFor(article.portada).width(960).height(640).fit("crop").url() : null;
        const date = article.fechaPublicacion
          ? new Date(article.fechaPublicacion).toLocaleDateString("es-ES", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })
          : "";
        const excerpt = excerptFromPortableText(article.contenido);

        return (
          <article
            class="article-item overflow-hidden rounded-2xl border border-[#E5EAF0] bg-white shadow-sm transition-shadow hover:shadow-md"
            data-search={`${article.titulo} ${excerpt} ${date}`.toLowerCase()}
          >
            <div class="grid gap-0 md:grid-cols-[220px_1fr] lg:grid-cols-[280px_1fr]">
              <a href={`/articles/${article.slug}`} class="block bg-[#F8F9FA]">
                {cover ? (
                  <img
                    src={cover}
                    alt={`Portada de ${article.titulo}`}
                    class="h-full w-full object-cover md:min-h-[220px]"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex min-h-[220px] items-center justify-center px-6 text-center text-sm text-gray-400">
                    Imagen no disponible
                  </div>
                )}
              </a>

              <div class="flex flex-col justify-between p-6 sm:p-7">
                <div>
                  <div class="flex items-center gap-3 text-xs uppercase tracking-[0.16em] text-gray-500">
                    <span>{date}</span>
                    <span class="h-px w-8 bg-[#D9E2EC]"></span>
                    <span>Artículo</span>
                  </div>

                  <h2 class="mt-3 text-2xl font-semibold leading-tight text-[#0056B3] sm:text-[1.65rem]">
                    <a href={`/articles/${article.slug}`} class="transition-colors hover:text-[#003366]">{article.titulo}</a>
                  </h2>

                  <p class="mt-4 max-w-3xl text-[1.02rem] leading-7 text-[#333333]">
                    {excerpt}
                  </p>
                </div>

                <div class="mt-6 flex items-center justify-between gap-4 text-sm text-gray-500">
                  <span>Lectura académica</span>
                  <a href={`/articles/${article.slug}`} class="font-medium text-[#0056B3] transition-colors hover:text-[#003366]">Leer artículo</a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div id="no-results" class="hidden border border-dashed border-[#D9E2EC] bg-white px-6 py-10 text-center text-gray-500">
      No se encontraron artículos con esa búsqueda.
    </div>
  </section>

  <script is:inline>
    const searchInput = document.getElementById("searchInput");
    const articleItems = Array.from(document.querySelectorAll(".article-item"));
    const noResults = document.getElementById("no-results");

    function filterArticles(query) {
      const normalizedQuery = query.trim().toLowerCase();
      let visibleCount = 0;

      articleItems.forEach((item) => {
        const matches = !normalizedQuery || item.dataset.search.includes(normalizedQuery);
        item.classList.toggle("hidden", !matches);

        if (matches) {
          visibleCount += 1;
        }
      });

      noResults.classList.toggle("hidden", visibleCount !== 0);
    }

    if (searchInput) {
      searchInput.addEventListener("input", (event) => {
        filterArticles(event.target.value);
      });

      filterArticles(searchInput.value);
    }
  </script>
</MainLayout>