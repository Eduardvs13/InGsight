---
import MainLayout from "../layouts/MainLayout.astro";
import { mockArticles } from "../data/mockArticles.js";

const articles = mockArticles;
---
---

<MainLayout title="Aletheia - Revista Academica">
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-[#0056B3]">Revista académica</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-[#003366] sm:text-5xl">Lectura clara, sin ruido visual.</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-[#333333] sm:text-lg">
        Un portal minimalista para leer, navegar y buscar artículos con una estructura limpia, estilo editorial y enfoque total en el contenido.
      </p>
    </div>

    <div class="mt-10 flex items-center justify-between border-b border-[#D9E2EC] pb-3 text-sm text-gray-500">
      <span>{articles.length} artículos de ejemplo</span>
      <span>Búsqueda en vivo desde el encabezado</span>
    </div>

    <div class="mt-8 space-y-6" id="article-list">
      {articles.map((article) => (
        <article
          class="article-item border-b border-[#E5EAF0] pb-6 last:border-b-0 last:pb-0"
          data-search={`${article.title} ${article.excerpt} ${article.author} ${article.date} ${article.slug}`.toLowerCase()}
        >
          <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-3 text-xs uppercase tracking-[0.14em] text-gray-500">
              <span>{article.date}</span>
              <span class="h-px w-8 bg-[#D9E2EC]"></span>
              <span>Artículo</span>
            </div>
            <h2 class="text-2xl font-semibold leading-tight text-[#0056B3] sm:text-[1.65rem]">
              <a href={`/articles/${article.slug}`} class="hover:text-[#003366]">{article.title}</a>
            </h2>
            <p class="max-w-3xl text-[1.05rem] leading-7 text-[#333333]">
              {article.excerpt}
            </p>
            <div class="flex items-center justify-between gap-4 text-sm text-gray-500">
              <span>{article.author}</span>
              <a href={`/articles/${article.slug}`} class="font-medium text-[#0056B3] hover:text-[#003366]">Leer artículo</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div id="no-results" class="hidden border border-dashed border-[#D9E2EC] bg-white px-6 py-10 text-center text-gray-500">
      No se encontraron artículos con esa búsqueda.
    </div>
  </section>

  <script is:inline>
    const searchInput = document.getElementById("searchInput");
    const articleItems = Array.from(document.querySelectorAll(".article-item"));
    const noResults = document.getElementById("no-results");

    function filterArticles(query) {
      const normalizedQuery = query.trim().toLowerCase();
      let visibleCount = 0;

      articleItems.forEach((item) => {
        const matches = !normalizedQuery || item.dataset.search.includes(normalizedQuery);
        item.classList.toggle("hidden", !matches);
        if (matches) visibleCount += 1;
      });

      noResults.classList.toggle("hidden", visibleCount !== 0);
    }

    if (searchInput) {
      searchInput.addEventListener("input", (event) => {
        filterArticles(event.target.value);
      });

      filterArticles(searchInput.value);
    }
  </script>
</MainLayout>
