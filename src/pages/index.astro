---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="InGsight — Donde la ingeniería cobra sentido">

  <!-- ── HERO ── -->
  <section style="position: relative; overflow: hidden; background: var(--hero-bg); padding: 3.5rem 1.5rem 2rem;">
    <!-- Decorative glow orbs -->
    <div style="position: absolute; inset: 0; pointer-events: none; overflow: hidden;" aria-hidden="true">
      <div style="position: absolute; top: -80px; right: -80px; width: 500px; height: 500px; background: radial-gradient(circle, var(--hero-glow-1) 0%, transparent 70%); border-radius: 50%;"></div>
      <div style="position: absolute; bottom: -60px; left: -60px; width: 400px; height: 400px; background: radial-gradient(circle, var(--hero-glow-2) 0%, transparent 70%); border-radius: 50%;"></div>
    </div>

    <div style="position: relative; max-width: 1200px; margin: 0 auto;">
      <div style="max-width: 700px;" class="animate-fade-in-up">

        <!-- Label -->
        <div class="flex items-center gap-4 mb-8">
          <span class="badge badge-accent">Blog</span>
          <div class="h-px bg-[var(--surface-border)] flex-grow max-w-[60px]"></div>
        </div>

        <!-- Headline -->
        <h1 style="font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; color: var(--text-title); margin-bottom: 1.25rem;">
          Donde la ingeniería<br/>
          <span style="background: var(--gradient-brand); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">cobra sentido</span>
        </h1>

        <!-- Subheading -->
        <p style="font-size: 1.125rem; color: var(--text-secondary); line-height: 1.75; max-width: 580px; margin-bottom: 2rem;">
          InGsight reúne investigación aplicada, análisis técnico y divulgación científica de primer nivel para la comunidad hispanohablante de ingeniería. Conocimiento riguroso, escrito con claridad.
        </p>

        <!-- CTAs -->
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;">
          <a href="#articulos" class="btn-primary">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Explorar artículos
          </a>
          <button id="heroSearchBtn" class="btn-ghost" onclick="document.getElementById('searchInput').focus()">
            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Buscar tema específico
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── STATS BAR ── -->
  <div style="background: var(--stats-bar-bg); border-top: 1px solid var(--surface-border); border-bottom: 1px solid var(--surface-border); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0.875rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;">
      <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
        <span id="article-count" style="font-size: 0.8rem; color: var(--text-muted);">
          <span style="display: inline-flex; gap: 6px; align-items: center;">
            <span class="skeleton" style="width: 80px; height: 14px; border-radius: 4px; display: inline-block;"></span>
          </span>
        </span>
      </div>
    </div>
  </div>

  <!-- ── ARTICLES GRID ── -->
  <section id="articulos" style="max-width: 1200px; margin: 0 auto; padding: 3rem 1.5rem 5rem;">

    <!-- Section header -->
    <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h2 style="font-family: var(--font-display); font-size: 1.75rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">
          Últimas publicaciones
        </h2>
        <p style="font-size: 0.875rem; color: var(--text-muted);">Ordenadas por fecha de publicación más reciente</p>
      </div>
    </div>

    <!-- Article list container -->
    <div id="article-list" aria-live="polite" role="list"
      style="display: flex; flex-direction: column; gap: 1.25rem;">
    </div>

    <!-- Empty / no results -->
    <div id="no-results" class="hidden" style="text-align: center; padding: 4rem 2rem; border: 1px dashed var(--surface-border); border-radius: var(--radius-xl);">
      <div style="width: 56px; height: 56px; margin: 0 auto 1.25rem; background: rgba(37,99,235,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--color-blue-400);" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>
      <p style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">Sin resultados</p>
      <p style="font-size: 0.875rem; color: var(--text-muted);">No se encontraron artículos que coincidan con tu búsqueda. Intenta con otros términos.</p>
    </div>

    <!-- Error state -->
    <div id="error-state" class="hidden" style="text-align: center; padding: 4rem 2rem; border: 1px solid rgba(239,68,68,0.2); border-radius: var(--radius-xl); background: rgba(239,68,68,0.05);">
      <p style="font-size: 0.875rem; color: #fca5a5; margin-bottom: 0.75rem;">No se pudo conectar con el servidor de contenido.</p>
      <button onclick="loadArticles()" class="btn-ghost" style="font-size: 0.8rem;">Reintentar</button>
    </div>

  </section>

  <script type="module">
    const PROJECT_ID = "8knpnv8f";
    const DATASET    = "production";
    const GROQ = '*[_type == "article" && defined(slug.current)] | order(fechaPublicacion desc){titulo, "slug": slug.current, portada, autores[]->{nombre, apellido}, fechaPublicacion, palabrasClave, contenido}';
    const API_URL = `https://${PROJECT_ID}.api.sanity.io/v1/data/query/${DATASET}?query=${encodeURIComponent(GROQ)}`;

    const $list    = document.getElementById("article-list");
    const $count   = document.getElementById("article-count");
    const $noRes   = document.getElementById("no-results");
    const $error   = document.getElementById("error-state");
    const $search  = document.getElementById("searchInput");

    // ── Utilities ──────────────────────────────────────────────
    function escapeHtml(v = "") {
      return String(v).replace(/[&<>"']/g, c =>
        ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])
      );
    }

    function imageUrlFromRef(ref) {
      if (!ref) return "";
      const m = ref.match(/^image-(.+)-([0-9]+x[0-9]+)-([a-z0-9]+)$/i);
      if (!m) return "";
      const [, id, dim, fmt] = m;
      return `https://cdn.sanity.io/images/${PROJECT_ID}/${DATASET}/${id}-${dim}.${fmt === "jpeg" ? "jpg" : fmt}`;
    }

    function excerptFromPortableText(blocks = []) {
      if (!Array.isArray(blocks)) return "";
      const text = blocks
        .map(b => (b?.children || []).map(c => c?.text || "").join(" "))
        .join(" ").replace(/\s+/g, " ").trim();
      if (!text) return "";
      const s = text.slice(0, 200).trim();
      return s.length < text.length ? `${s}…` : s;
    }

    function readingTime(blocks = []) {
      const wpm = 200;
      const words = (blocks || []).flatMap(b => (b?.children || []).map(c => c?.text || "")).join(" ").split(/\s+/).length;
      return Math.max(1, Math.round(words / wpm));
    }

    function initials(autores = []) {
      if (!autores.length) return "??";
      const a = autores[0];
      return `${(a.nombre||"?")[0]}${(a.apellido||"?")[0]}`.toUpperCase();
    }

    function formatDate(iso) {
      if (!iso) return "";
      return new Date(iso).toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
    }

    // ── Render ─────────────────────────────────────────────────
    function renderArticles(items, filter = "") {
      const q = filter.trim().toLowerCase();
      const visible = q
        ? items.filter(a => {
            const authorsStr = (a.rawAutores || []).map(au => `${au.nombre || ''} ${au.apellido || ''}`).join(" ");
            return `${a.titulo} ${a.excerpt} ${(a.keywords||[]).join(" ")} ${authorsStr}`.toLowerCase().includes(q);
          })
        : items;

      $count.innerHTML = `<span style="color:var(--text-secondary);font-weight:500;">${items.length}</span> <span>artículo${items.length !== 1 ? "s" : ""} publicado${items.length !== 1 ? "s" : ""}</span>`;
      $noRes.classList.toggle("hidden", visible.length !== 0);

      if (!visible.length) { $list.innerHTML = ""; return; }

      $list.innerHTML = visible.map((article, i) => {
        const mins = article.rt;
        const date = article.dateLabel;
        const authors = (article.rawAutores || []).map(a => [a.nombre, a.apellido].filter(Boolean).join(" ")).join(", ") || "InGsight";
        const hasMultipleAuthors = (article.rawAutores || []).length > 1;
        const avatarContent = hasMultipleAuthors 
          ? `<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`
          : escapeHtml(initials(article.rawAutores || []));
        const hasCover = !!article.cover;

        return `
          <article role="listitem"
            class="glass card-lift animate-fade-in-up"
            style="position: relative; border-radius: var(--radius-lg); overflow: hidden; animation-delay: ${i * 0.07}s;"
          >
            <a href="/articles?slug=${encodeURIComponent(article.slug)}" style="position: absolute; inset: 0; z-index: 1;" aria-label="Leer artículo completo"></a>
            <div style="display: grid; grid-template-columns: 1fr; min-height: 180px; position: relative; z-index: 2; pointer-events: none;">
              ${hasCover ? `
                <div style="position: relative; overflow: hidden; height: 220px;">
                  <img
                    src="${escapeHtml(article.cover)}"
                    alt="Portada del artículo: ${escapeHtml(article.titulo)}"
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease;"
                    onmouseover="this.style.transform='scale(1.04)'"
                    onmouseout="this.style.transform='scale(1)'"
                  />
                  <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(4,13,26,0.7) 0%, transparent 50%);"></div>
                </div>
              ` : ""}

              <div style="padding: 1.75rem 2rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem;">
                <!-- Meta row -->
                <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                  ${date ? `<span class="badge badge-accent">${escapeHtml(date)}</span>` : ""}
                  <span style="color: var(--surface-border-hover); font-size: 0.75rem;">·</span>
                  <span class="badge badge-teal">
                    <svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
                    ${mins} min de lectura
                  </span>
                </div>

                <!-- Title -->
                <div style="pointer-events: auto;">
                  <h2 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; line-height: 1.3; margin-bottom: 0.75rem;">
                    <a href="/articles?slug=${encodeURIComponent(article.slug)}" style="color: var(--text-primary); text-decoration: none;">
                      ${escapeHtml(article.titulo)}
                    </a>
                  </h2>
                  ${article.excerpt ? `
                    <p style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                      ${escapeHtml(article.excerpt)}
                    </p>
                  ` : ""}
                </div>

                <!-- Keywords -->
                ${article.keywords && article.keywords.length ? `
                  <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                    ${article.keywords.slice(0, 4).map(k => `
                      <span style="font-size: 0.7rem; padding: 2px 8px; border-radius: 999px; background: var(--pill-bg); border: 1px solid var(--surface-border); color: var(--text-secondary); font-weight: 500;">
                        ${escapeHtml(k)}
                      </span>
                    `).join("")}
                  </div>
                ` : ""}

                <!-- Author + CTA -->
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--surface-border);">
                  <div style="display: flex; align-items: center; gap: 0.65rem;">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--gradient-brand); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700; color: white; flex-shrink: 0;" aria-hidden="true">
                      ${avatarContent}
                    </div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 500;">${escapeHtml(authors)}</span>
                  </div>
                  <div style="pointer-events: auto;">
                    <a href="/articles?slug=${encodeURIComponent(article.slug)}" style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.8rem; font-weight: 600; color: var(--color-blue-400); text-decoration: none; transition: all 200ms; padding: 0.35rem 0.85rem; border-radius: 8px; border: 1px solid rgba(59,130,246,0.25);"
                      onmouseover="this.style.background='rgba(37,99,235,0.15)'; this.style.color='var(--color-blue-300)'"
                      onmouseout="this.style.background='transparent'; this.style.color='var(--color-blue-400)'">
                      Leer artículo
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join("");
    }

    // ── Skeletons ───────────────────────────────────────────────
    function renderSkeletons(n = 4) {
      $list.innerHTML = Array.from({ length: n }).map(() => `
        <div style="border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--surface-border); background: var(--surface-card); padding: 1.75rem 2rem;">
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div class="skeleton" style="width: 140px; height: 20px;"></div>
            <div class="skeleton" style="width: 75%; height: 28px;"></div>
            <div class="skeleton" style="width: 90%; height: 16px;"></div>
            <div class="skeleton" style="width: 65%; height: 16px;"></div>
          </div>
        </div>
      `).join("");
    }

    // ── Fetch ───────────────────────────────────────────────────
    async function loadArticles() {
      renderSkeletons();
      $error.classList.add("hidden");
      try {
        const res  = await fetch(API_URL);
        const data = await res.json();
        const raw  = Array.isArray(data.result) ? data.result : [];

        const items = raw.map(a => ({
          slug:       a.slug,
          titulo:     a.titulo,
          excerpt:    excerptFromPortableText(a.contenido),
          dateLabel:  formatDate(a.fechaPublicacion),
          cover:      a.portada?.asset?._ref ? imageUrlFromRef(a.portada.asset._ref) : "",
          keywords:   Array.isArray(a.palabrasClave) ? a.palabrasClave : [],
          rt:         readingTime(a.contenido),
          rawAutores: Array.isArray(a.autores) ? a.autores : [],
        }));

        renderArticles(items, $search?.value ?? "");

        if ($search) {
          $search.addEventListener("input", e => renderArticles(items, e.target.value));
        }
      } catch (err) {
        $count.textContent = "Error al cargar artículos";
        $list.innerHTML = "";
        $error.classList.remove("hidden");
        console.error("[InGsight] Error fetching articles:", err);
      }
    }

    window.loadArticles = loadArticles;
    loadArticles();
  </script>

</MainLayout>